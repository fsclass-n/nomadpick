{
  "_comment": "여행사별 수집 설정. home 방문 후 discover 규칙(해외 특가·국내)마다 정규식으로 현재 기획전 주소를 찾고, 못 찾으면 그 규칙의 fallback 을 사용한다. 셀렉터 문법: 'css' → 텍스트, 'css@attr' → 속성, '@attr' → 상품 요소 자신의 속성, 'a|b' → a 가 없으면 b. code_city: 상품명에 지명이 없을 때 상품코드 접두어로 도시 추정(노랑풍선 KJ=제주). 페이지 구조가 바뀌면 코드 수정 없이 이 파일만 갱신한다.",
  "hanatour": {
    "name": "하나투어",
    "home": "https://www.hanatour.com/",
    "discover": [
      {"pattern": "urlAdrs:\"(/promotion/plan/[A-Za-z0-9]+)\"[^}]{0,400}?menuNm:\"(?:임박특가|특가여행)\"", "base": "https://www.hanatour.com", "max": 1,
       "fallback": ["https://www.hanatour.com/promotion/plan/PM006787B572"]},
      {"pattern": "href=\"(/promotion/plan/[A-Za-z0-9]+)\"[^>]*>(?:울릉도/섬|내나라여행)<", "base": "https://www.hanatour.com", "max": 2,
       "fallback": ["https://www.hanatour.com/promotion/plan/PM0066C4A448", "https://www.hanatour.com/promotion/plan/PM0067A9E64E"]}
    ],
    "parser": "css",
    "wait_for": "div.card-wrap",
    "exclude_keywords": ["항공권"],
    "selectors": {
      "item": "div.card-wrap",
      "code": "@id",
      "title": ".text-group p",
      "depart": ".label.time",
      "duration": ".option-group span:nth-of-type(2)",
      "price": "span.price strong",
      "origin": ".option-group span:nth-of-type(1)",
      "image": "img@data-src|img@src"
    }
  },
  "modetour": {
    "name": "모두투어",
    "home": "https://www.modetour.com/",
    "discover": [
      {"pattern": "\"link\":\"(?:https://www\\.modetour\\.com)?(/promotion/\\d+)\"", "base": "https://www.modetour.com", "max": 3,
       "fallback": ["https://www.modetour.com/promotion/1542", "https://www.modetour.com/promotion/1557"]},
      {"pattern": "\"gnbLinkUrl\":\"(/package/domestic)\"", "base": "https://www.modetour.com", "max": 1,
       "fallback": ["https://www.modetour.com/package/domestic"]}
    ],
    "parser": "next_data",
    "wait_for": "#__NEXT_DATA__",
    "exclude_keywords": ["항공권"],
    "fields": {
      "code": "masterCode",
      "title": "masterProductName",
      "price": "price",
      "depart": "minDepartureDate",
      "departure_dates": "departureDates",
      "dates": "dates",
      "origin": "depatureFrom",
      "airline": "productCodes[0].marketingAirName",
      "image": "image"
    }
  },
  "ybtour": {
    "name": "노랑풍선",
    "home": "https://www.ybtour.co.kr/",
    "discover": [
      {"pattern": "href=\"(https://pkg\\.ybtour\\.co\\.kr/promotion/promotionDetail\\.yb\\?mstNo=\\d+)\"[^>]*>\\s*긴급특가", "max": 1,
       "fallback": ["https://pkg.ybtour.co.kr/promotion/promotionDetail.yb?mstNo=20000028710"]},
      {"pattern": "href=\"(https://pkg\\.ybtour\\.co\\.kr/promotion/promotionDetail\\.yb\\?mstNo=\\d+)\"[^>]*?dspMenuCd&quot;:&quot;DMT&quot;", "max": 3,
       "fallback": ["https://pkg.ybtour.co.kr/promotion/promotionDetail.yb?mstNo=20000031489", "https://pkg.ybtour.co.kr/promotion/promotionDetail.yb?mstNo=20000030625"]}
    ],
    "parser": "css",
    "wait_for": "ul.list_thum li, ul.list_prod li.item",
    "exclude_keywords": ["항공권"],
    "code_city": {"KJ": "제주"},
    "selectors": {
      "item": "ul.list_thum > li, ul.list_prod > li.item",
      "code": "@data-braze-temp-goods-cd",
      "title": "p.tit",
      "depart": "p.txt em|p.term .date",
      "price": "p.sale em|p.price em|strong.emp_red",
      "original_price": "p.price em",
      "image": "img@data-real|img@src"
    }
  }
}
