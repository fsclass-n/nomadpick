{
  "_comment": "여행사별 수집 설정. home 방문 후 discover 정규식으로 현재 특가 페이지를 찾고, 없으면 list_urls 를 사용한다. 셀렉터 문법: 'css' → 텍스트, 'css@attr' → 속성, '@attr' → 상품 요소 자신의 속성, 'a|b' → a 가 없으면 b. 페이지 구조가 바뀌면 코드 수정 없이 이 파일만 갱신한다.",
  "hanatour": {
    "name": "하나투어",
    "home": "https://www.hanatour.com/",
    "discover": {"pattern": "urlAdrs:\"(/promotion/plan/[A-Za-z0-9]+)\"[^}]{0,400}?menuNm:\"(?:임박특가|특가여행)\"", "base": "https://www.hanatour.com", "max": 1},
    "list_urls": ["https://www.hanatour.com/promotion/plan/PM006787B572"],
    "parser": "css",
    "wait_for": "div.card-wrap",
    "exclude_keywords": ["항공권"],
    "selectors": {
      "item": "div.card-wrap",
      "code": "@id",
      "title": ".text-group p",
      "depart": ".label.time",
      "duration": ".option-group span:nth-of-type(2)",
      "price": "span.price strong",
      "origin": ".option-group span:nth-of-type(1)"
    }
  },
  "modetour": {
    "name": "모두투어",
    "home": "https://www.modetour.com/",
    "discover": {"pattern": "\"link\":\"(?:https://www\\.modetour\\.com)?(/promotion/\\d+)\"", "base": "https://www.modetour.com", "max": 3},
    "list_urls": ["https://www.modetour.com/promotion/1542", "https://www.modetour.com/promotion/1557"],
    "parser": "next_data",
    "wait_for": "#__NEXT_DATA__",
    "exclude_keywords": ["항공권"],
    "fields": {
      "code": "masterCode",
      "title": "masterProductName",
      "price": "price",
      "depart": "minDepartureDate",
      "departure_dates": "departureDates",
      "dates": "dates",
      "origin": "depatureFrom",
      "airline": "productCodes[0].marketingAirName"
    }
  },
  "ybtour": {
    "name": "노랑풍선",
    "home": "https://www.ybtour.co.kr/",
    "discover": {"pattern": "href=\"(https://pkg\\.ybtour\\.co\\.kr/promotion/promotionDetail\\.yb\\?mstNo=\\d+)\"[^>]*>\\s*긴급특가", "max": 1},
    "list_urls": ["https://pkg.ybtour.co.kr/promotion/promotionDetail.yb?mstNo=20000028710"],
    "parser": "css",
    "wait_for": "ul.list_thum li",
    "exclude_keywords": ["항공권"],
    "selectors": {
      "item": "ul.list_thum > li",
      "code": "@data-braze-temp-goods-cd",
      "title": "p.tit",
      "depart": "p.txt em",
      "price": "p.sale em|p.price em",
      "original_price": "p.price em"
    }
  }
}
