# =====================================================================
# NomadPick 환경 변수
#  - 로컬 · EC2 : 이 파일을 복사하여 프로젝트 루트에 .env 로 저장한 뒤 값을 채운다. (cp .env.example .env)
#  - Render     : 대시보드 > Environment > "Add from .env" 에 아래 [1] 구역만 복사하여 붙여넣는다.
#                 ([2] 는 넣지 않아도 기본값으로 동작, [3]·[4] 는 Render 에 넣지 않는다)
#  - .env 는 Git 저장소에 커밋하지 않는다.
#
#  구역      | 로컬 | EC2 | Render
#  [1] 공통 필수 |  O   |  O  |  O
#  [2] 선택     |  선택 | 선택 | 선택 (기본값과 같으면 생략 가능)
#  [3] 로컬 전용 |  O   |  -  |  -
#  [4] EC2 전용  |  -   |  O  |  -
# =====================================================================


# =====================================================================
# [1] 공통 필수 - Render 에 넣을 변수 (로컬·EC2·Render 모두)
# =====================================================================

# 실행 환경 (local / ec2 / render) - /api/v1/health 응답에 표시
APP_ENV=local

# 데이터베이스 (TiDB Cloud, MySQL 8.x 호환) - 로컬 테스트 포함 모든 환경에서 사용
# TiDB Cloud > 클러스터 > Connect (SQLAlchemy / PyMySQL) 의 값을 아래 형식으로 입력
# 예) mysql+pymysql://<user>:<password>@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/nomadpick
DATABASE_URL=

# 인증
JWT_SECRET=change-me-to-a-long-random-string
RPA_API_KEY=change-me-rpa-key

# 초기 계정 (최초 실행 시 생성)
ADMIN_EMAIL=admin@nomadpick.example.com
ADMIN_PASSWORD=change-me-admin
DEMO_EMAIL=demo@nomadpick.example.com
DEMO_PASSWORD=change-me-demo

# CORS (Netlify 프런트엔드 도메인)
CORS_ORIGINS=https://nomadpick.netlify.app,https://noamdpick.netlify.app,https://nomadpick.onrender.com,https://nomadpick.duckdns.org,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# 국토교통부 공공데이터 API (공공데이터포털 서비스 키 - Decoding 키)
# 국토교통부_(TAGO)_국내항공운항정보 : https://www.data.go.kr/data/15098526/openapi.do
DATA_GO_KR_KEY=

# 서버 내장 RPA 스케줄러 (특가 30분 09~21시 / 공공데이터 07:00 / 리포트 21:30)
# Render 무료 플랜(512MB)은 Playwright 메모리가 부족할 수 있어, EC2 운영 시 Render 는 false 권장
ENABLE_SCHEDULER=true
# DB 가 비어 있으면 서버 시작 시 1회 수집
COLLECT_ON_STARTUP=true
# BOT-01 특가 수집 실행 여부 (RPA_ENGINE=http 이면 Render 무료에서도 30분마다 동작)
ENABLE_DEALS_JOB=true
# 수집 엔진: http(기본, 브라우저 없이 여행사 공개 JSON 수집 · 수십 MB) / browser(Playwright Chromium · 300MB+)
#   두 엔진은 같은 여행사 데이터를 같은 규칙으로 변환 → 상품코드·출발일이 같아 한 DB 에 함께 적재 가능
RPA_ENGINE=http
# 누적 방식: 수집에서 빠진 상품을 마지막 확인 후 몇 시간 동안 계속 노출할지 (출발 기간이 지난 상품은 즉시 숨김)
RPA_RETENTION_HOURS=72
# 서버 2대 혼용 (같은 TiDB)
#   primary : 특가 수집 매시 0·30분 항상 실행 (EC2 · RPA_ENGINE=browser 권장)
#   fallback: 매시 15·45분에 확인해 최근 25분 안에 수집 성공이 없는 여행사만 대신 수집 (Render · RPA_ENGINE=http)
#             EC2 가 없거나 멈추면 fallback 이 30분마다 직접 수집 (EC2 없이도 동작)
#   Dockerfile 기본값은 fallback(Render), docker-compose.yml(EC2)은 primary 로 덮어씀
RPA_ROLE=primary
# RPA_DEALS_MINUTES=0,30
# RPA_FALLBACK_STALE_MIN=25
# 수집 로그에 표시할 서버 이름 (Render 는 자동으로 render)
# RPA_NODE=ec2

# 로그인 화면 테스트 계정 버튼 (일반: DEMO_EMAIL / 관리자: DEMO_ADMIN_EMAIL, 관리자 체험 계정은 조회 전용)
DEMO_LOGIN_ENABLED=true
DEMO_ADMIN_EMAIL=demo-admin@nomadpick.example.com

# SNS 로그인 (키를 넣은 제공자만 버튼 활성화)
# 각 개발자 콘솔에 콜백 등록: {PUBLIC_BASE_URL}/api/v1/auth/oauth/{google|naver|kakao}/callback
#   Google: console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 (OAuth 클라이언트 ID, 웹 애플리케이션)
#   Naver : developers.naver.com > 애플리케이션 등록 (네이버 로그인, 이메일·이름)
#   Kakao : developers.kakao.com > 내 애플리케이션 (REST API 키 = CLIENT_ID, 카카오 로그인 활성화, Client Secret 은 선택)
PUBLIC_BASE_URL=https://nomadpick.onrender.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=


# =====================================================================
# [2] 선택 - 아래 값은 코드 기본값과 같으므로 생략 가능 (바꿀 때만 입력)
# =====================================================================

# TiDB Cloud 는 TLS 접속 필수
DB_SSL=true
JWT_EXPIRE_MINUTES=60
# live: Playwright 로 여행사 실사이트만 / sample: 내장 샘플 페이지만 / auto: live 실패 시 sample
RPA_SOURCE_MODE=auto
# direct: DB 직접 적재(서버 내장 스케줄러) / api: X-RPA-KEY 로 API 전송
RPA_SINK=direct
REQUEST_INTERVAL_SEC=2
# 사람과 같은 브라우저 접근 (비우면 실제 Chrome 131 User-Agent 사용)
RPA_USER_AGENT=
PLAYWRIGHT_HEADLESS=true
# chromium(새 headless, 기본) / chrome(로컬에 설치된 Chrome) / 빈 값(headless shell)
PLAYWRIGHT_CHANNEL=chromium
PLAYWRIGHT_TIMEOUT_MS=45000
# 불필요한 리소스 요청 차단 (메모리·트래픽 절약, Render 512MB 대응)
PLAYWRIGHT_BLOCK_MEDIA=true
# 차단할 리소스 유형 (page.route 의 resource_type)
PLAYWRIGHT_BLOCK_TYPES=image,media,font,stylesheet,texttrack,manifest
# 웹 서버 보호: RPA 를 별도 저우선순위 프로세스로 실행, 한도 초과 시 Chromium 까지 강제 종료
# (Dockerfile 기본값: TIMEOUT 900 · AGENCY 240 · MEMORY 300 · RETRIES 1 · PLAYWRIGHT_TIMEOUT_MS 30000
#  → Render 에는 아래 값을 넣지 않아야 Dockerfile 의 저메모리 기본값이 적용됨)
RPA_ISOLATED=true
RPA_JOB_TIMEOUT_SEC=1200
RPA_AGENCY_TIMEOUT_SEC=480
# 0 = 제한 없음 (Linux 에서만 감시)
RPA_MEMORY_LIMIT_MB=0
RPA_RETRIES=3


# =====================================================================
# [3] 로컬 전용 - Render·EC2 에는 넣지 않음
# =====================================================================

# pytest 전용 DB (비우면 DATABASE_URL 과 같은 클러스터의 nomadpick_test 데이터베이스를 자동 생성·사용)
TEST_DATABASE_URL=
# RPA_SINK=api 로 수집기를 따로 실행할 때 전송할 서버 주소
API_BASE_URL=http://127.0.0.1:8000


# =====================================================================
# [4] EC2 전용 - docker compose + Caddy 자동 HTTPS, DuckDNS IP 갱신 (Render 에는 넣지 않음)
# =====================================================================

DOMAIN=nomadpick.duckdns.org
DUCKDNS_SUBDOMAIN=nomadpick
DUCKDNS_TOKEN=
